<mujoco model="g1_table_red_block">
  <!--
    G1 Table Red Block scene — converted from LuckyEngine .hscene
    Contains: G1 robot, ground plane, table, red cylindrical block (freejoint),
              head camera, wrist camera, overhead camera, tracking camera.
  -->

  <include file="g1.xml"/>

  <statistic center="0.2 0 0.5" extent="2"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <!-- Skybox -->
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <!-- Light grey floor -->
    <texture type="2d" name="groundplane" builtin="flat"
             rgb1="0.75 0.75 0.75" rgb2="0.7 0.7 0.7"
             mark="random" markrgb="0.72 0.72 0.72"
             width="512" height="512"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="8 8" reflectance="0.1"/>
    <!-- Table materials -->
      <material name="table_wood" rgba="0.55 0.35 0.2 1" specular="0.3" shininess="0.5"/>
      <material name="table_blue" rgba="0.1 0.12 0.3 1" specular="0.3" shininess="0.5"/>
    <!-- Red block material -->
      <material name="red_plastic" rgba="0.85 0.1 0.1 1" specular="0.5" shininess="0.8"/>
      <material name="blue_plastic" rgba="0.12 0.28 0.85 1" specular="0.45" shininess="0.75"/>
      <material name="book_cover" rgba="0.12 0.45 0.2 1" specular="0.35" shininess="0.6"/>
  </asset>

  <worldbody>
    <!-- Ground plane -->
    <geom name="ground" type="plane" size="10 10 0.01" material="groundplane"
          contype="1" conaffinity="1"/>

    <!-- Ambient light -->
    <light pos="0 0 4" dir="0 0 -1" diffuse="0.7 0.7 0.7" specular="0.3 0.3 0.3"
           castshadow="true"/>
    <light pos="-2 2 3" dir="0.5 -0.5 -1" diffuse="0.3 0.3 0.3" specular="0.1 0.1 0.1"/>

    <!-- Table (static), in front of the robot -->
    <!-- Long side faces the robot along world Y. -->
    <body name="table" pos="-0.2 -0.12 0.713">
      <geom name="table_top" type="box" size="0.25 0.4 0.02" material="table_wood"
            contype="1" conaffinity="1" friction="1 0.1 0.01" mass="10"/>
      <!-- Table legs -->
      <geom name="table_leg_1" type="cylinder" size="0.025 0.345" pos="0.2 0.35 -0.365"
            rgba="0.4 0.25 0.15 1" contype="1" conaffinity="1" mass="1"/>
      <geom name="table_leg_2" type="cylinder" size="0.025 0.345" pos="-0.2 0.35 -0.365"
            rgba="0.4 0.25 0.15 1" contype="1" conaffinity="1" mass="1"/>
      <geom name="table_leg_3" type="cylinder" size="0.025 0.345" pos="0.2 -0.35 -0.365"
            rgba="0.4 0.25 0.15 1" contype="1" conaffinity="1" mass="1"/>
      <geom name="table_leg_4" type="cylinder" size="0.025 0.345" pos="-0.2 -0.35 -0.365"
            rgba="0.4 0.25 0.15 1" contype="1" conaffinity="1" mass="1"/>
    </body>

    <!-- Red cylinder (dynamic, with freejoint) -->
    <!-- Hazel: pos=[0.235, 0.85, -0.026], scale=[0.03, 0.07, 0.03] -->
    <!-- MuJoCo Z-up: pos=[-0.12, 0.2, 0.78] -->
      <body name="red_cylinder" pos="-0.27 -0.05 0.813">
      <freejoint name="red_cylinder_joint"/>
      <geom name="red_cylinder_geom" type="cylinder" size="0.02 0.05"
            material="red_plastic" density="100"
            contype="1" conaffinity="1" friction="3 0.1 0.01"/>
      <!-- Thin box caps to reinforce top/bottom collision without tipping -->
      <geom name="red_cap_top" type="box" size="0.018 0.018 0.002" pos="0 0 0.05"
            rgba="0.85 0.1 0.1 1" density="10"
            contype="1" conaffinity="1" friction="3 0.1 0.01"/>
      <geom name="red_cap_middle" type="box" size="0.018 0.018 0.002" pos="0 0 0.03"
            rgba="0.85 0.1 0.1 1" density="10"
            contype="1" conaffinity="1" friction="3 0.1 0.01"/>
      <geom name="red_cap_bot" type="box" size="0.018 0.018 0.002" pos="0 0 -0.05"
            rgba="0.85 0.1 0.1 1" density="10"
            contype="1" conaffinity="1" friction="3 0.1 0.01"/>
    </body>

    <!-- Blue cube: directly in front of robot, on the table -->
      <body name="blue_cube" pos="-0.27 -0.05 0.7555">
            <freejoint name="blue_cube_joint"/>
            <geom name="blue_cube_geom" type="box" size="0.0225 0.0225 0.0225"
                              material="blue_plastic" density="160"
                              contype="1" conaffinity="1" friction="2.5 0.15 0.02"/>
    </body>

    <!-- Red basket on robot right side of the stacked objects -->
    <body name="red_basket" pos="-0.2 -0.22 0.733">
      <geom name="red_basket_base" type="box" size="0.045 0.045 0.003"
            material="red_plastic" contype="1" conaffinity="1" friction="2.0 0.1 0.01"/>
      <geom name="red_basket_wall_n" type="box" pos="0 0.042 0.025" size="0.045 0.003 0.025"
            material="red_plastic" contype="1" conaffinity="1" friction="2.0 0.1 0.01"/>
      <geom name="red_basket_wall_s" type="box" pos="0 -0.042 0.025" size="0.045 0.003 0.025"
            material="red_plastic" contype="1" conaffinity="1" friction="2.0 0.1 0.01"/>
      <geom name="red_basket_wall_e" type="box" pos="0.042 0 0.025" size="0.003 0.045 0.025"
            material="red_plastic" contype="1" conaffinity="1" friction="2.0 0.1 0.01"/>
      <geom name="red_basket_wall_w" type="box" pos="-0.042 0 0.025" size="0.003 0.045 0.025"
            material="red_plastic" contype="1" conaffinity="1" friction="2.0 0.1 0.01"/>
    </body>

    <!-- Blue basket on robot left side of the stacked objects -->
    <body name="blue_basket" pos="-0.3 -0.22 0.733">
      <geom name="blue_basket_base" type="box" size="0.045 0.045 0.003"
            material="blue_plastic" contype="1" conaffinity="1" friction="2.0 0.1 0.01"/>
      <geom name="blue_basket_wall_n" type="box" pos="0 0.042 0.025" size="0.045 0.003 0.025"
            material="blue_plastic" contype="1" conaffinity="1" friction="2.0 0.1 0.01"/>
      <geom name="blue_basket_wall_s" type="box" pos="0 -0.042 0.025" size="0.045 0.003 0.025"
            material="blue_plastic" contype="1" conaffinity="1" friction="2.0 0.1 0.01"/>
      <geom name="blue_basket_wall_e" type="box" pos="0.042 0 0.025" size="0.003 0.045 0.025"
            material="blue_plastic" contype="1" conaffinity="1" friction="2.0 0.1 0.01"/>
      <geom name="blue_basket_wall_w" type="box" pos="-0.042 0 0.025" size="0.003 0.045 0.025"
            material="blue_plastic" contype="1" conaffinity="1" friction="2.0 0.1 0.01"/>
    </body>
  </worldbody>
</mujoco>
